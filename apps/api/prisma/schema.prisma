generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum FulfillmentType {
  HOT_NOW
  SCHEDULED
}

enum OptionSelectType {
  SINGLE
  MULTI
  QTY
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  OUT_FOR_DELIVERY
  SCHEDULED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD
  JAZZCASH
  EASYPAISA
  STRIPE
}

enum PaymentStatus {
  PENDING
  INITIATED
  PAID
  FAILED
  REFUNDED
}

enum DiscountType {
  PERCENT
  FIXED
}

model Role {
  id          String      @id @default(cuid())
  name        String      @unique
  slug        String      @unique
  description String?
  permissions String[]
  isSystem    Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  users       AdminUser[]
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  roleId       String?
  role         Role?     @relation(fields: [roleId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Customer {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  orders       Order[]
}

model Category {
  id              String          @id @default(cuid())
  name            String
  slug            String          @unique
  description     String?
  image           String?
  fulfillmentType FulfillmentType
  displayOrder    Int             @default(0)
  isActive        Boolean         @default(true)
  parentId        String?
  parent          Category?       @relation("CategoryTree", fields: [parentId], references: [id])
  children        Category[]      @relation("CategoryTree")
  products        Product[]
  optionGroups    CategoryOptionGroup[]
  promos          Promo[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([fulfillmentType, isActive, displayOrder])
}

model Product {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  description   String?
  image         String?
  pricePkr      Int
  costPkr       Int?
  compareAtPkr  Int?
  categoryId    String
  category      Category @relation(fields: [categoryId], references: [id])
  displayOrder  Int      @default(0)
  isActive      Boolean  @default(true)
  packSize      String?
  weightGrams   Int?
  piecesPerPack Int?
  optionGroups  ProductOptionGroup[]
  promos        Promo[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([categoryId, isActive, displayOrder])
}

model OptionGroup {
  id           String           @id @default(cuid())
  name         String
  slug         String           @unique
  selectType   OptionSelectType
  required     Boolean          @default(false)
  minSelect    Int              @default(0)
  maxSelect    Int?
  displayOrder Int              @default(0)
  values       OptionValue[]
  categories   CategoryOptionGroup[]
  products     ProductOptionGroup[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model OptionValue {
  id            String      @id @default(cuid())
  optionGroupId String
  optionGroup   OptionGroup @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)
  label         String
  priceDeltaPkr Int         @default(0)
  displayOrder  Int         @default(0)
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([optionGroupId, displayOrder])
}

model CategoryOptionGroup {
  categoryId    String
  optionGroupId String
  category      Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  optionGroup   OptionGroup @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)

  @@id([categoryId, optionGroupId])
}

model ProductOptionGroup {
  productId     String
  optionGroupId String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionGroup   OptionGroup @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)

  @@id([productId, optionGroupId])
}

model DeliveryZone {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  feePkr        Int
  etaMinutesMin Int      @default(30)
  etaMinutesMax Int      @default(60)
  isActive      Boolean  @default(true)
  displayOrder  Int      @default(0)
  orders        Order[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Promo {
  id            String       @id @default(cuid())
  code          String       @unique
  name          String
  discountType  DiscountType
  discountValue Int
  minOrderPkr   Int          @default(0)
  categoryId    String?
  category      Category?    @relation(fields: [categoryId], references: [id])
  productId     String?
  product       Product?     @relation(fields: [productId], references: [id])
  startsAt      DateTime?
  endsAt        DateTime?
  isActive      Boolean      @default(true)
  orders        Order[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Order {
  id             String        @id @default(cuid())
  orderNumber    String        @unique
  status         OrderStatus   @default(PENDING)
  customerId     String?
  customer       Customer?     @relation(fields: [customerId], references: [id])
  customerName   String
  customerPhone  String
  customerEmail  String?
  addressLine    String
  deliveryZoneId String
  deliveryZone   DeliveryZone  @relation(fields: [deliveryZoneId], references: [id])
  paymentMethod  PaymentMethod
  paymentStatus  PaymentStatus @default(PENDING)
  paymentRef     String?
  subtotalPkr    Int
  deliveryFeePkr Int
  discountPkr    Int           @default(0)
  totalPkr       Int
  promoId        String?
  promo          Promo?        @relation(fields: [promoId], references: [id])
  scheduledFor   DateTime?
  notes          String?
  items          OrderItem[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([orderNumber])
  @@index([customerId, createdAt])
}

model OrderItem {
  id                String          @id @default(cuid())
  orderId           String
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId         String
  productName       String
  productSlug       String
  fulfillmentType   FulfillmentType
  unitPricePkr      Int
  quantity          Int
  lineTotalPkr      Int
  selectionsJson    Json
  notes             String?
  createdAt         DateTime        @default(now())
}
