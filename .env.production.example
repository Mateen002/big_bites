# ==============================================================================
# BigBites Production Environment Variables
# Copy this file to .env on your VPS
# ==============================================================================

# 1. Database (PostgreSQL / Supabase)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# 2. Redis Cache & Session Store (Local VPS Redis)
REDIS_URL="redis://localhost:6379"

# 3. API Security & Secrets
API_PORT=4000
API_URL="http://localhost:4000"
JWT_SECRET="generate-a-random-64-character-secret-key-here"

# 4. CORS Whitelist (Include VPS IP and later your domain)
# Example before domain: http://195.201.x.x,http://195.201.x.x:3000,http://195.201.x.x:3001
# Example after domain:  https://bigbites.store,https://admin.bigbites.store
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# 5. Admin Initial Credentials
ADMIN_EMAIL="manager@bigbites.pk"
ADMIN_PASSWORD="ChooseAStrongPassword123!"

# 6. Storefront & Kitchen Dispatch
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_WHATSAPP_SUPPORT="923001234567"

# 7. Payments (COD enabled by default; digital gateways offline for launch)
JAZZCASH_MERCHANT_ID=""
EASYPAISA_STORE_ID=""
STRIPE_SECRET_KEY=""

