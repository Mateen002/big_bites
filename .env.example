# Local SQLite (default — no Docker required)
DATABASE_URL="file:./dev.db"

# Production / Docker Compose Postgres:
# DATABASE_URL="postgresql://bigbites:bigbites@localhost:5432/bigbites?schema=public"

# Redis (optional — API falls back to in-memory cart if unavailable)
REDIS_URL="redis://localhost:6379"

# API
API_PORT=4000
API_URL="http://localhost:4000"
JWT_SECRET="bigbites-dev-jwt-secret-change-in-production"
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# Storefront / Admin
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
ADMIN_EMAIL="admin@bigbites.pk"
ADMIN_PASSWORD="BigBites@Admin1"

# Payments (sandbox — leave empty for mock adapters)
JAZZCASH_MERCHANT_ID=""
EASYPAISA_STORE_ID=""
STRIPE_SECRET_KEY=""
